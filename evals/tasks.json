{
  "version": 1,
  "tasks": [
    {
      "id": "quick-trim",
      "kind": "quick-edits",
      "difficulty": "everyday",
      "request": "Please make a six-second copy of clip.mp4 from 2 to 8 seconds. Save it as deliver/output.mp4.",
      "inputs": {
        "clip.mp4": "interview.mp4"
      },
      "automatic": [
        {
          "method": "video",
          "path": "deliver/output.mp4",
          "duration": [
            5.9,
            6.1
          ],
          "audio_required": true
        },
        {
          "method": "audio_chunks",
          "path": "deliver/output.mp4",
          "source": "interview.mp4",
          "intervals": [
            [
              2.3,
              3.6
            ],
            [
              6.3,
              7.6
            ]
          ]
        }
      ],
      "review": [
        {
          "id": "normal-speed-review",
          "description": "Watch muted and listen at normal speed; say where the cut fails."
        }
      ],
      "scorecard_dimensions": [
        "image"
      ],
      "recipe": "skills/legible-film/references/recipes.md#quick-edits"
    },
    {
      "id": "quick-ambiguous-crop",
      "kind": "quick-edits",
      "difficulty": "hard",
      "request": "Make a vertical crop of clip.mp4. I want to keep the important person in frame.",
      "inputs": {
        "clip.mp4": "interview.mp4"
      },
      "automatic": [
        {
          "method": "question",
          "terms": [
            "person",
            "subject",
            "speaker"
          ]
        }
      ],
      "review": [
        {
          "id": "question-quality",
          "description": "The question asks for the missing decision, is concise and does not invent facts."
        },
        {
          "id": "no-premature-crop",
          "description": "Do not choose a subject when the intended subject is unclear."
        }
      ],
      "scorecard_dimensions": [
        "composition"
      ],
      "recipe": "skills/legible-film/references/recipes.md#quick-edits"
    },
    {
      "id": "captions-basic",
      "kind": "captions-only",
      "difficulty": "everyday",
      "request": "Please caption talk.mp4. Put the SRT at deliver/captions.srt, and give me WebVTT too.",
      "inputs": {
        "talk.mp4": "interview.mp4"
      },
      "automatic": [
        {
          "method": "captions",
          "path": "deliver/captions.srt",
          "reference": "interview.srt"
        },
        {
          "method": "exists",
          "path": "deliver/captions.vtt"
        }
      ],
      "review": [
        {
          "id": "publisher-verification",
          "description": "Check the reference captions against the actual audio, including names."
        }
      ],
      "scorecard_dimensions": [
        "text",
        "access"
      ],
      "recipe": "skills/legible-film/references/recipes.md#captions-only"
    },
