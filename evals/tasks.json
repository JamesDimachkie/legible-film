    {
      "id": "interview-tighten",
      "kind": "interview",
      "difficulty": "everyday",
      "request": "Tighten this conversation in interview.mp4. Remove the very long pause, keep both speakers and their sentences intact, and save deliver/output.mp4.",
      "inputs": {
        "interview.mp4": "interview-gap.mp4"
      },
      "automatic": [
        {
          "method": "video",
          "path": "deliver/output.mp4",
          "duration": [
            9.8,
            10.8
          ],
          "audio_required": true
        },
        {
          "method": "audio_chunks",
          "path": "deliver/output.mp4",
          "source": "interview.mp4",
          "intervals": [
            [
              0.3,
              1.7
            ],
            [
              2.6,
              3.8
            ],
            [
              4.4,
              5.3
            ],
            [
              5.8,
              7.0
            ],
            [
              7.4,
              8.5
            ],
            [
              8.6,
              9.7
            ]
          ]
        },
        {
          "method": "silence",
          "path": "deliver/output.mp4",
          "max_seconds": 1.5
        }
      ],
      "review": [
        {
          "id": "normal-speed-review",
          "description": "Watch muted and listen at normal speed; say where the cut fails."
        },
        {
          "id": "content",
          "description": "Check that the selected material is complete, accurate and meaningful without prior context."
        },
        {
          "id": "join",
          "description": "Listen to each join and check that no word is clipped."
        }
      ],
      "scorecard_dimensions": [
        "structure",
        "pacing",
        "voice"
      ],
      "recipe": "skills/legible-film/references/recipes.md#interview-or-talking-head"
    },
